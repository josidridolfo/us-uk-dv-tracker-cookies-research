# Residential-exit credentials for the crawl container. Copy to .env and fill;
# .env is git-excluded. An exported environment variable overrides the file.
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# Per-run parameters, supplied at invocation rather than stored here: country
# follows the jurisdiction under crawl and the session token is generated fresh
# per run. The relay refuses to start when either is absent.
#   IPROYAL_COUNTRY=gb
#   IPROYAL_SESSION=
IPROYAL_LIFETIME=10m

# Build and runtime defaults, overridden only to pin a different base image or
# relay address.
#   OPENWPM_BASE=dv-openwpm-base:v0.38.0
#   DV_RELAY_HOST=relay
#   DV_RELAY_PORT=8080
#   DV_DATA_ROOT=/data
