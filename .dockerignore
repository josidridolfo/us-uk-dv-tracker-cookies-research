# The crawl image needs source only. Everything else is build-context weight,
# and the credential and capture paths must never enter an image layer.
.git/
.env
.env.*
data/
tests/
report/
manual_validation/
notebooks/
docs/
scripts/
# Classification lists are read by the analysis stage outside the container.
# The Consent-O-Matic rules and CMP vendor hosts stay, since the crawl probes
# read them in-page.
tracker_lists/ddg_tracker_radar/
tracker_lists/easyprivacy/
tracker_lists/open_cookie_database/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
